# =============================================================================
# ShiftManager SaaS — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to source control.
# =============================================================================

# -------------------------
# SECURITY (REQUIRED)
# -------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# -------------------------
# AI ASSISTANT (REQUIRED)
# -------------------------
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# -------------------------
# DATABASE (OPTIONAL)
# -------------------------
# Leave empty to use local SQLite (dev only — data lost on redeploy!).
# For production on Render, set to the Internal Database URL of your PostgreSQL instance.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
